    "settings": {
        "project": {
            "name": "Musica11y",
            "version": [
                1,
                4,
                7
            ],
            "description": "Accessible XR Music Experience \nDesign lead: Damian Mills.\nProgramming lead: Rodney McConnnell."
        },
        "xr": {
            "leftEyeObject": "18",
            "rightEyeObject": "19",
            "ar": {
                "enable": true
            },
            "webxr": {
                "optionalFeatures": {
                    "plane-detection": false,
                    "local-floor": true,
                    "anchors": false,
                    "bounded-floor": false
                },
                "requiredFeatures": {
                    "anchors": false,
                    "bounded-floor": false,
                    "local-floor": false
                }
            }
        },
        "scripting": {
            "components": {
                "sourcePaths": [
                    "js/"
                ],
                "bundling": "none"
            },
            "libraryPaths": [
                "/js/lib/"
            ],
            "application": {
                "output": "Musica11y-bundle.js",
                "bundling": "esbuild",
                "esbuildFlags": "--format=esm",
                "entryPoint": "js/index.js"
            }
        },
        "rendering": {
            "hdr": {
                "exposure": 1.5
            },
            "clearColor": [
                0.1679999,
                0.1679999,
                0.1679999,
                0.0
            ],
            "environment": {
                "bakingMode": "sky",
                "material": null
            }
        },
        "runtime": {
            "visualizeColliders": false
        }
    },
