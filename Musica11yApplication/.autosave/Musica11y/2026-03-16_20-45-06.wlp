        "2386": {
            "name": "Text",
            "parent": "2337",
            "components": [
                {
                    "type": "text",
                    "text": {
                        "text": "Enter VR using the Play VR button.\n\nThis will bring you to a new view\nof the instrument you have created.\n\nThis method allows you to see\nmore of the world around you\nwhen you play. You will see a left \npanel, a centre panel, and a right \npanel.\n\nYou can play with the instrument\nas it is presented\nor you can alter the size and shape\nof the instrument using the \ncolour cubes.\n\nYou can play the instrument \nwith your hands or if you prefer\nusing your forehead with Gaze Ray!\n\nGaze Ray hover is where you look at\na virtual object for a period of time to \nselect an object. Notes activated \nusing Gaze-Ray activate instantly.",
                        "alignment": "left",
                        "verticalAlignment": "top"
                    }
                }
            ],
            "scaling": [
                1.102024,
                1.6208475,
                4.243
            ],
            "translation": [
                -0.8849338,
                -0.454629,
                -0.0710837
            ],
            "rotation": [
                -3.739265537205938e-7,
                0.0,
                -0.0,
                1.0
            ]
        },
