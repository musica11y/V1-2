        "2402": {
            "name": "Text",
            "parent": "2395",
            "components": [
                {
                    "type": "text",
                    "text": {
                        "text": "\nLayers are accessed using the add\nlayer buttons.\n\nYou can create an instrument pattern\non each layer.\nEach layer can be given a new\nSoundfont instrument. The current \nSoundfont is listed.\n\nMove between layers using the layer \nicons.\n\nLayers can be added to either or all\nthe three panels. These panels are \naccessed one at a time in the EDIT\nMODE view. The three panels are\nall visible in the VR PLAY view.\n\n",
                        "alignment": "left",
                        "verticalAlignment": "top"
                    }
                }
            ],
            "scaling": [
                1.1046901,
                1.6895275,
                4.4227886
